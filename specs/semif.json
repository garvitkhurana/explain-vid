      "caption": "Most agent decisions are tiny: route this, retry that.",
      "data": {
        "title": "SemIf",
        "subtitle": "Semantic ifs from open models",
        "kicker": "Why generate text you immediately parse back into an if?"
      }
    },
    {
      "id": "how",
      "type": "pipeline",
      "duration_s": 7,
      "caption": "Options become single-token letters. One forward pass scores them. No answer is generated.",
      "data": {
        "inputs": [
          "State",
          "Question",
          "Options → A, B, C"
        ],
        "model": "Qwen3.5-4B",
        "stages": [
          "A / B / C scores",
          "Probabilities"
        ]
      }
    },
    {
      "id": "readout",
      "type": "readout",
