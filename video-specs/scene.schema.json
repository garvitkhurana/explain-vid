{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "meta",
    "scenes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "fps",
        "size",
        "arc",
        "thesis"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "enum": [
                "repo",
                "blog",
                "paper"
              ]
            },
            "url": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            }
          },
          "description": "Where the video comes from; drives the standard `source` end card."
        },
        "fps": {
          "const": 30
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "voice": {
          "type": "object"
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "plain"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "plain": {
                "type": "string"
              }
            }
          }
        },
        "arc": {
          "enum": [
            "tool",
            "concept",
            "result"
          ],
          "description": "Story shape, picked by what the content is (not where it came from). tool: hook \u2192 how \u2192 why \u2192 use. concept: hook \u2192 how \u2192 why \u2192 takeaway. result: hook \u2192 problem \u2192 how \u2192 proof. Every part must appear (check.py)."
        },
        "thesis": {
          "type": "string",
          "description": "The video's point in one sentence, written before the scenes. It must be said in the narration of the scene with the arc's thesis role (tool: hook, concept: takeaway, result: proof), not just shown (check.py)."
        },
        "cast": {
          "type": "object",
          "required": [
            "skin",
            "roles"
          ],
          "additionalProperties": false,
          "properties": {
            "skin": {
              "enum": [
                "office",
                "rpg"
              ],
              "description": "Default setting; SKIN=<name> overrides at render time."
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "explainer",
                  "asker",
                  "reactor"
                ]
              }
            }
          },
          "description": "Pixel cast (renderers/manim/skins.py). Narration names roles, never characters; the skin decides who plays them."
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "duration_s",
          "narration",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "title",
              "metrics",
              "cycle",
              "checklist",
              "compare",
              "commands",
              "alternatives",
              "flow",
              "source",
              "steps",
              "chunks",
              "interview"
            ]
          },
          "role": {
            "enum": [
              "hook",
              "how",
              "why",
              "use",
              "takeaway",
              "problem",
              "proof"
            ],
            "description": "Which part of meta.arc this scene is. Every scene but the closing source card has one."
          },
          "duration_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 60,
            "description": "Minimum length; the narration audio can make the scene longer."
          },
          "data": {
            "type": "object",
            "properties": {
              "set": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "shot": {
                    "enum": [
                      "board"
                    ]
                  },
                  "cast": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "enum": [
                        "explainer",
                        "asker",
                        "reactor"
                      ]
                    }
                  },
                  "tags": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "description": "Name tags: role \u2192 the concept that character plays in this scene."
                  },
                  "acts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "who",
                        "do",
                        "at"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "who": {
                          "enum": [
                            "explainer",
                            "asker",
                            "reactor"
                          ]
                        },
                        "do": {
                          "enum": [
                            "point",
                            "shrug",
                            "facepalm",
                            "look_camera",
                            "nod",
                            "level_up"
                          ]
                        },
                        "at": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 2,
                              "maxItems": 2
                            },
                            {
                              "type": "string",
                              "minLength": 1
                            }
                          ],
                          "description": "Sentence index, [sentence, fraction], or a phrase from this scene's narration (lands on its first word)."
                        }
                      }
                    }
                  }
                },
                "description": "Board shot: the template runs on the skin's board with up to two cast members beside it."
              }
            }
          },
          "narration": {
            "type": "array",
            "minItems": 0,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                {
                  "type": "object",
                  "required": [
                    "who",
                    "say"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "who": {
                      "enum": [
                        "explainer",
                        "asker",
                        "reactor"
                      ]
                    },
                    "say": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "kind": {
                      "enum": [
                        "wrong",
                        "question"
                      ],
                      "description": "An asker's wrong guess (the explainer must answer it in the same scene) or plain question."
                    }
                  }
                }
              ]
            },
            "description": "Spoken sentences. Single source for audio, on-screen captions and subtitles. Empty only for the closing `source` card. With meta.cast, an item may be {who, say, kind?}; plain strings are the explainer's."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "metrics"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "cards"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "Optional headline at the top (step `title`, sentence 0); cards then start at sentence 1."
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "cards": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "value",
                          "compare"
                        ]
                      }
                    },
                    "footnote": {
                      "type": "string",
                      "description": "Closing line under the cards. Narrating it before every card is a render error: use `title`."
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "flow"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "nodes",
                    "steps"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "Optional headline; the figure is laid out and centred in the space below it."
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "properties": {
                          "art": {
                            "enum": [
                              "wave",
                              "lines"
                            ],
                            "description": "Drawn under the label: wave = audio bars in the role colour (rise in when a flow lands on the node first); lines = grey text lines (a document)."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "alternatives"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "title",
                    "panels"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "footer": {
                      "type": "string"
                    },
                    "panels": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "kind"
                        ],
                        "properties": {
                          "label": {
                            "type": "string",
                            "description": "Window title-bar text."
                          },
                          "kind": {
                            "enum": [
                              "terminal",
                              "browser"
                            ]
                          },
                          "role": {
                            "enum": [
                              "neutral",
                              "c1",
                              "c2",
                              "c3",
                              "c4",
                              "c5"
                            ]
                          },
                          "caption": {
                            "type": "string",
                            "description": "One plain line under the window."
                          },
                          "lines": {
                            "type": "array",
                            "maxItems": 7,
                            "items": {
                              "type": "object",
                              "minProperties": 1,
                              "maxProperties": 1,
                              "properties": {
                                "cmd": {
                                  "type": "string"
                                },
                                "out": {
                                  "type": "string"
                                },
                                "comment": {
                                  "type": "string"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "url": {
                            "type": "string"
                          },
                          "fields": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "label",
                                "value"
                              ],
                              "properties": {
                                "label": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "slider": {
                            "type": "object",
                            "required": [
                              "label",
                              "value"
                            ],
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            }
                          },
                          "button": {
                            "type": "string"
                          },
                          "log": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cycle"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "nodes",
                    "steps"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "nodes": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 6,
                      "description": "Ring nodes, clockwise from the top; the last one's arrow returns to the first.",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "label"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "sub": {
                            "type": "string"
                          },
                          "edge": {
                            "type": "string",
                            "description": "Label on the arrow leaving this node."
                          }
                        }
                      }
                    },
                    "enter": {
                      "type": "object",
                      "required": [
                        "label"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "sub": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        },
                        "side": {
                          "enum": [
                            "left",
                            "right",
                            "above",
                            "below"
                          ]
                        }
                      }
                    },
                    "exit": {
                      "type": "object",
                      "required": [
                        "label",
                        "from"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "sub": {
                          "type": "string"
                        },
                        "from": {
                          "type": "string"
                        },
                        "edge": {
                          "type": "string"
                        },
                        "side": {
                          "enum": [
                            "left",
                            "right",
                            "above",
                            "below"
                          ]
                        }
                      }
                    },
                    "panel": {
                      "type": "object",
                      "required": [
                        "title",
                        "lines"
                      ],
                      "description": "Side panel of lines revealed by steps' `show` (e.g. a message list).",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "note": {
                          "type": "string"
                        },
                        "lines": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "text"
                            ],
                            "properties": {
                              "role": {
                                "type": "string"
                              },
                              "text": {
                                "type": "string"
                              },
                              "code": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Step i lands on sentence i unless beats override. `at`: node id, 'enter' or 'exit' (the marker travels there round the ring; `lap` goes once round). `show`: panel lines visible after this step.",
                      "items": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string"
                          },
                          "show": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "lap": {
                            "type": "boolean",
                            "description": "With `at` on the node the marker is already on: go once round the ring."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "steps"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "Headline (step `title`, sentence 0); item i then lands on sentence i + 1."
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "items": {
                        "type": "object",
                        "required": [
                          "label"
                        ],
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "sub": {
                            "type": "string"
                          },
                          "code": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Real source lines shown in the code window; each must appear verbatim in facts.json."
                          },
                          "art": {
                            "enum": [
                              "wave"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "chunks"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "title",
                    "doc",
                    "chunks",
                    "engine",
                    "output"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "doc": {
                      "type": "string",
                      "description": "Label on the document."
                    },
                    "chunks": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 5,
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                      },
                      "description": "Text lines drawn per chunk (geometry only)."
                    },
                    "engine": {
                      "type": "object",
                      "required": [
                        "label"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "sub": {
                          "type": "string"
                        }
                      }
                    },
                    "output": {
                      "type": "string"
                    },
                    "footnote": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "interview"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "required": [
                    "who"
                  ],
                  "properties": {
                    "who": {
                      "enum": [
                        "explainer",
                        "asker",
                        "reactor"
                      ]
                    },
                    "set": {
                      "type": "object",
                      "properties": {
                        "acts": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "who",
                              "do",
                              "at"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "who": {
                                "enum": [
                                  "explainer",
                                  "asker",
                                  "reactor"
                                ]
                              },
                              "do": {
                                "enum": [
                                  "point",
                                  "shrug",
                                  "facepalm",
                                  "look_camera",
                                  "nod",
                                  "level_up"
                                ]
                              },
                              "at": {
                                "oneOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  {
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                  },
                                  {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                ],
                                "description": "Sentence index, [sentence, fraction], or a phrase from this scene's narration (lands on its first word)."
                              }
                            }
                          }
                        }
                      }
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 32,
                      "description": "What this character stands for in the video; shown under their name."
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
