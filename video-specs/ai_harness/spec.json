    {
      "id": "failures",
      "type": "metrics",
      "role": "why",
      "duration_s": 8,
      "narration": [
        "Most operational failures come from the harness, not the model.",
        "As history grows, reasoning gets worse: context rot.",
        "Hand it too many tools, and it gets confused before it starts.",
        "Chain many tool calls, and a reply can take ten seconds or longer."
      ],
