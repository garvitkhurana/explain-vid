          "shot": "board",
          "cast": [
            "explainer",
            "asker"
          ],
          "acts": [
            {
              "who": "asker",
              "do": "shrug",
              "at": "actually is"
            },
            {
              "who": "explainer",
              "do": "point",
              "at": "without a framework"
            }
          ]
        }
      }
