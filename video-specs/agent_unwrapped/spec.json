            "label": "Your code",
            "sub": "the loop"
          },
          {
            "id": "tool",
            "role": "tool",
            "label": "calculator()",
            "sub": "Python function"
          }
        ],
        "edges": [
          {
            "from": "task",
            "to": "model"
          },
          {
            "from": "model",
            "to": "code"
          },
          {
