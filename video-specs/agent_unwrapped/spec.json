              "role": "system",
              "text": "Solve the task. Use tools when helpful. Be brief."
            },
            {
              "role": "user",
              "text": "Use the calculator tool for 21 * 2. Reply with only the numeric value."
            },
            {
              "role": "assistant",
              "text": "tool_call: calculator(\"21*2\")",
              "code": true
            },
            {
              "role": "tool",
              "text": "{\"ok\": true, \"expression\": \"21*2\", \"value\": 42.0}",
              "code": true
            },
            {
              "role": "assistant",
              "text": "42"
            }
          ],
          "note": "illustrative run of the calc-basic task"
