      "duration_s": 3,
      "narration": [
        {
          "who": "asker",
          "say": "So what actually is an AI agent?",
          "kind": "question"
        },
        "agent-unwrapped shows what an AI agent really is, without a framework."
      ],
      "data": {
        "title": "What is an AI agent?",
        "subtitle": "agent-unwrapped: the raw loop, no framework",
        "kicker": "The model asks. Your code runs the tool.",
