      "duration_s": 6,
      "narration": [
        "Given just a high-level prompt, even with compaction, Claude failed in two ways.",
        "It tried to build everything at once, and ran out of context halfway through a feature.",
        "Or a later session saw some progress, and declared the whole job done."
      ],
      "data": {
        "cards": [
          {
            "label": "Failure 1",
            "value": "One-shotting",
            "compare": "runs out of context mid-feature"
          },
          {
            "label": "Failure 2",
            "value": "Early victory",
            "compare": "sees progress, stops"
          }
