{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "meta",
    "scenes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "fps",
        "size"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "fps": {
          "const": 30
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "voice": {
          "type": "object"
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "plain"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "plain": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "duration_s",
          "narration",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "title",
              "problem",
              "pipeline",
              "race",
              "bars",
              "metrics",
              "outro",
              "readout",
              "branch",
              "loop",
              "checklist",
              "fanout",
              "gantt",
              "balance"
            ]
          },
          "duration_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 30,
            "description": "Minimum length; the narration audio can make the scene longer."
          },
          "data": {
            "type": "object"
          },
          "narration": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": "Spoken sentences. Single source for audio, on-screen captions and subtitles."
          }
        }
      }
    }
  }
}
